---
/**
 * Contact and professional links. One centered column of large tap targets.
 * No phone number, by decision (see BUILD_SPEC §5). No contact form — mailto only.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  {
    label: 'Email',
    detail: 'nicklausw2000@gmail.com',
    href: 'mailto:nicklausw2000@gmail.com',
    icon: 'M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Zm0 2 8 5 8-5',
  },
  {
    label: 'LinkedIn',
    detail: 'linkedin.com/in/nicklaus-w',
    href: 'https://www.linkedin.com/in/nicklaus-w/',
    icon: 'M6 9v10M6 5v.5M10 19v-6a3 3 0 0 1 6 0v6M10 9v10',
  },
  {
    label: 'GitHub',
    detail: 'github.com/nicklaus88',
    href: 'https://github.com/nicklaus88',
    icon: 'M15 21v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.8 11.8 0 0 0-6.4 0C6.4 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21M9 18c-3 1-3-1.5-5-2',
  },
  {
    label: 'Résumé',
    detail: 'PDF',
    href: '/witham_nicklaus_resume.pdf',
    icon: 'M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V8l-5-5Zm0 0v5h5M9 13h6M9 17h6',
  },
  // Uncomment when there is a Scholar profile to link.
  // {
  //   label: 'Google Scholar',
  //   detail: 'scholar.google.com',
  //   href: 'https://scholar.google.com/citations?user=XXXX',
  //   icon: 'M12 3 2 9l10 6 10-6-10-6Zm-6 9.5V16c0 2 3 4 6 4s6-2 6-4v-3.5',
  // },
];
---

<BaseLayout
  title="Links"
  description="Contact Nick Witham: email, LinkedIn, GitHub, and résumé."
>
  <section class="container links">
    <h1>Links</h1>
    <p class="lede">The easiest way to reach me is email.</p>

    <ul>
      {links.map(({ label, detail, href, icon }) => (
        <li>
          <a href={href} rel={href.startsWith('http') ? 'noopener' : undefined}>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={icon} />
            </svg>
            <span class="label">{label}</span>
            <span class="detail">{detail}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .links {
    max-width: 32rem;
    padding-top: var(--space-2xl);
  }

  .lede {
    margin-top: var(--space-m);
    color: var(--text-muted);
  }

  ul {
    list-style: none;
    margin: var(--space-xl) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-s);
  }

  a {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-m);
    align-items: center;
    min-height: 64px;
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: border-color 150ms ease;
  }

  a:hover {
    border-color: var(--accent);
    color: var(--text);
  }

  svg {
    grid-row: 1 / span 2;
    color: var(--accent);
  }

  .label {
    font-weight: 550;
  }

  .detail {
    font-size: var(--step--1);
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }
</style>
