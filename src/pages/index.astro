---
/**
 * Home. Intro + background, then up to three featured projects.
 * All prose below is placeholder; grep for PLACEHOLDER to find it.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/projects';

const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);

// Set to false to hide the portrait until a real photo is in place.
const showPortrait = true;
---

<BaseLayout
  title="Nick Witham"
  description="Nick Witham — 3rd Year Mechanical Engineering, University of Florida. Projects in manipulation, mechanism design, and controls."
>
  <section class="container intro">
    <div class="intro-text">
      <h1>Nick Witham</h1>
      <!-- PLACEHOLDER: owner to replace -->
      <p class="tagline">3rd Year Mechanical Engineering at the University of Florida.</p>

      <!-- PLACEHOLDER: owner to replace -->
      <p>
        I’m interested in autonomous systems and robotics, with hands-on experience in robot navigation, manipulation, and deep learning. I’m currently a research assistant at the Robotic Perception and Intelligence Lab (RoboPI) at UF under Dr. Md Jahidul Islam. There, I’ve worked on a cross-embodiment autonomous navigation project and a reinforcement learning controller for AUV diving and surfacing. I’m looking for robotics internships for spring and summer 2027.      
      </p>
      <!-- PLACEHOLDER: owner to replace -->
      <p>
        I’ve also built quadcopters at the Non-Linear Controls and Robotics (NCR) Lab, where I deployed a takeoff and landing controller, and contributed to a robotic bamboo harvester project at the Computer Vision and Sensing Systems (COVISS) Lab. I also designed, manufactured, and analyzed suspension components for Gator Motorsports. On my own time, I build projects like a reinforcement learning controller for a humanoid robot and a 3D-printed four-degree-of-freedom robotic arm.
      </p>
    </div>

    {showPortrait && (
      <img
        class="portrait"
        src="/profile_picture.png"
        alt="Portrait of Nick Witham"
        width="200"
        height="200"
        loading="eager"
        decoding="sync"
      />
    )}
  </section>

  {featured.length > 0 && (
    <section class="container featured" aria-labelledby="featured-heading">
      <h2 id="featured-heading" class="section-heading">Featured projects</h2>
      <ul class="grid">
        {featured.map((project) => (
          <li>
            <ProjectCard project={project} eager />
          </li>
        ))}
      </ul>
      <p class="see-all">
        <a href="/projects">See all projects &rarr;</a>
      </p>
    </section>
  )}
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-l);
    padding-top: var(--space-2xl);
  }

  .intro-text {
    max-width: var(--width-content);
  }

  .intro-text > * + * {
    margin-top: var(--space-m);
  }

  .tagline {
    font-size: var(--step-1);
    color: var(--text-muted);
    margin-top: var(--space-s);
  }

  .portrait {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .intro {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--space-2xl);
    }

    .portrait {
      width: 200px;
      height: 200px;
      margin-top: var(--space-xs);
    }
  }

  .featured {
    padding-top: var(--space-3xl);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .see-all {
    margin-top: var(--space-l);
  }
</style>
