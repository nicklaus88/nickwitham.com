---
/**
 * Home. Intro + background, then up to three featured projects.
 * All prose below is placeholder; grep for PLACEHOLDER to find it.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/projects';
import portrait from '../assets/profile-placeholder.jpg';

const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);

// Set to false to hide the portrait until a real photo is in place.
const showPortrait = true;
---

<BaseLayout
  title="Nick Witham"
  description="Nick Witham — mechanical engineering and robotics, University of Florida. Projects in manipulation, mechanism design, and controls."
>
  <section class="container intro">
    <div class="intro-text">
      <h1>Nick Witham</h1>
      <!-- PLACEHOLDER: owner to replace -->
      <p class="tagline">Mechanical engineering and robotics, University of Florida.</p>

      <!-- PLACEHOLDER: owner to replace -->
      <p>
        This is placeholder text describing what you work on and what you're interested in.
        Two or three sentences is plenty. Say what kind of problems you like, what you've built,
        and what you're looking for next.
      </p>
      <!-- PLACEHOLDER: owner to replace -->
      <p>
        A second short paragraph can cover background: where you study, which lab or team you're
        part of, and anything a visitor should know before they look at the projects below.
      </p>
    </div>

    {showPortrait && (
      <Image
        class="portrait"
        src={portrait}
        alt=""
        width={320}
        widths={[320, 640]}
        sizes="(min-width: 640px) 200px, 140px"
        loading="eager"
        decoding="sync"
        format="webp"
      />
    )}
  </section>

  {featured.length > 0 && (
    <section class="container featured" aria-labelledby="featured-heading">
      <h2 id="featured-heading" class="section-heading">Featured projects</h2>
      <ul class="grid">
        {featured.map((project) => (
          <li>
            <ProjectCard project={project} eager />
          </li>
        ))}
      </ul>
      <p class="see-all">
        <a href="/projects">See all projects &rarr;</a>
      </p>
    </section>
  )}
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-l);
    padding-top: var(--space-2xl);
  }

  .intro-text {
    max-width: var(--width-content);
  }

  .intro-text > * + * {
    margin-top: var(--space-m);
  }

  .tagline {
    font-size: var(--step-1);
    color: var(--text-muted);
    margin-top: var(--space-s);
  }

  .portrait {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .intro {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: var(--space-2xl);
    }

    .portrait {
      width: 200px;
      height: 200px;
      margin-top: var(--space-xs);
    }
  }

  .featured {
    padding-top: var(--space-3xl);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .see-all {
    margin-top: var(--space-l);
  }
</style>
