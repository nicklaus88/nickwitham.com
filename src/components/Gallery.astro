---
/**
 * Image grid for project detail pages. Rendered only when `gallery` is non-empty.
 */
import { Image } from 'astro:assets';
import type { Project } from '../lib/projects';

interface Props {
  items: Project['data']['gallery'];
}

const { items } = Astro.props;
---

<section class="gallery" aria-label="Gallery">
  <h2>Gallery</h2>
  <ul>
    {items.map(({ src, alt, caption }) => (
      <li>
        <figure>
          <Image
            src={src}
            alt={alt}
            width={1200}
            widths={[600, 1200, 1800]}
            sizes="(min-width: 1024px) 540px, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
            decoding="async"
            format="webp"
          />
          {caption && <figcaption>{caption}</figcaption>}
        </figure>
      </li>
    ))}
  </ul>
</section>

<style>
  .gallery h2 {
    margin-bottom: var(--space-l);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-l);
  }

  @media (min-width: 640px) {
    ul {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  figure {
    margin: 0;
  }

  img {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  figcaption {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>
