---
/**
 * YouTube click-to-load facade.
 *
 * Renders a plain thumbnail with a play button. Nothing from YouTube is
 * requested except the poster image until the viewer clicks — then the facade
 * is swapped for a youtube-nocookie.com iframe with autoplay. The 16:9 box
 * keeps the layout stable across the swap.
 */
interface Props {
  youtubeId: string;
  title: string;
  caption?: string;
}

const { youtubeId, title, caption } = Astro.props;
const poster = `https://i.ytimg.com/vi/${youtubeId}/maxresdefault.jpg`;
const posterFallback = `https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`;
---

<figure class="video">
  <div class="frame" data-video-facade data-youtube-id={youtubeId} data-title={title}>
    <img
      src={poster}
      alt=""
      width="1280"
      height="720"
      loading="lazy"
      decoding="async"
      data-fallback={posterFallback}
      onerror={`if(this.src!==this.dataset.fallback){this.src=this.dataset.fallback}`}
    />
    <button type="button" class="play" aria-label={`Play video: ${title}`}>
      <svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
        <path class="play-bg" d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" />
        <path d="M45 24 27 14v20" fill="#fff" />
      </svg>
    </button>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  // One tiny listener per facade. Runs once per page; the script is inlined
  // and deduplicated by Astro across multiple <VideoEmbed /> instances.
  document.querySelectorAll<HTMLElement>('[data-video-facade]').forEach((frame) => {
    const button = frame.querySelector<HTMLButtonElement>('button.play');
    if (!button) return;

    button.addEventListener('click', () => {
      const id = frame.dataset.youtubeId ?? '';
      const title = frame.dataset.title ?? 'Video';

      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1`;
      iframe.title = title;
      iframe.setAttribute('allow', 'accelerometer; autoplay; encrypted-media; picture-in-picture');
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('loading', 'lazy');

      frame.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .video {
    margin: 0;
  }

  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    width: 100%;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .frame img,
  .frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .frame img {
    object-fit: cover;
  }

  .play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .play-bg {
    fill: rgb(33 33 33 / 0.8);
    transition: fill 150ms ease;
  }

  .play:hover .play-bg,
  .play:focus-visible .play-bg {
    fill: #f00;
  }

  .play:focus-visible {
    outline-offset: -4px;
  }

  figcaption {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
</style>
