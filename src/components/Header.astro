---
/**
 * Site nav. On narrow screens it collapses into a <details> disclosure —
 * no JavaScript needed for the toggle.
 */
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/links', label: 'Links' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">Nick Witham</a>

    <nav class="nav-wide" aria-label="Primary">
      <ul>
        {links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <details class="nav-narrow">
      <summary>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <span>Menu</span>
      </summary>
      <nav aria-label="Primary">
        <ul>
          {links.map(({ href, label }) => (
            <li>
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-m);
  }

  .brand {
    font-weight: 650;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .brand:hover {
    color: var(--accent);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-l);
  }

  nav a {
    color: var(--text-muted);
    text-decoration: none;
    padding-block: var(--space-2xs);
  }

  nav a:hover {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  /* Narrow: disclosure menu. The open panel drops below the header bar. */
  .nav-narrow {
    display: none;
  }

  .nav-narrow summary {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    cursor: pointer;
    list-style: none;
    color: var(--text-muted);
    padding: var(--space-xs);
    margin: calc(-1 * var(--space-xs));
    border-radius: var(--radius);
    min-height: 44px;
  }

  .nav-narrow summary::-webkit-details-marker {
    display: none;
  }

  .nav-narrow summary:hover {
    color: var(--text);
  }

  .nav-narrow nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    padding-inline: var(--space-m);
  }

  .nav-narrow ul {
    flex-direction: column;
    gap: 0;
  }

  .nav-narrow li a {
    display: block;
    padding-block: var(--space-s);
    min-height: 44px;
    border-top: 1px solid var(--border);
  }

  .nav-narrow li:first-child a {
    border-top: 0;
  }

  @media (max-width: 639px) {
    .nav-wide {
      display: none;
    }

    .nav-narrow {
      display: block;
    }
  }
</style>
